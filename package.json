{
  "name": "kanto-ds",
  "version": "0.1.0",
  "description": "Dark-first, framework-agnostic design system for data-dense product interfaces.",
  "keywords": [
    "design-system",
    "web-components",
    "custom-elements",
    "lit",
    "ui",
    "dark-theme"
  ],
  "homepage": "https://github.com/MrArnaudMichel/kanto#readme",
  "bugs": "https://github.com/MrArnaudMichel/kanto/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrArnaudMichel/kanto.git"
  },
  "license": "MIT",
  "author": "Arnaud Michel <contact@arnaudmichel.fr>",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/components/**/kt-*.ts",
    "./dist/components/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens/*": "./dist/tokens/*",
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types && npm run build:static",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.json",
    "build:static": "node scripts/copy-static.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"fs.rmSync(dist,{recursive:true,force:true})\""
  },
  "dependencies": {
    "lit": "^3.3.3",
    "lucide": "^1.43.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
