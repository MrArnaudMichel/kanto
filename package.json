{
  "name": "kanto-ds",
  "version": "0.1.0",
  "description": "Dark-first, framework-agnostic design system for data-dense product interfaces.",
  "keywords": [
    "design-system",
    "web-components",
    "custom-elements",
    "lit",
    "ui",
    "dark-theme"
  ],
  "homepage": "https://github.com/MrArnaudMichel/kanto#readme",
  "bugs": "https://github.com/MrArnaudMichel/kanto/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrArnaudMichel/kanto.git"
  },
  "license": "MIT",
  "author": "Arnaud Michel <contact@arnaudmichel.fr>",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/components/**",
    "./dist/icons/defaults.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens/*": "./dist/tokens/*",
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "npm run build:js && npm run build:types && npm run build:static",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:static": "node scripts/copy-static.js",
    "build:demo": "vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"fs.rmSync(dist,{recursive:true,force:true})\"",
    "check:exports": "node scripts/check-exports.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:exports"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "lit": "^3.3.3",
    "lucide": "^1.43.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  }
}
