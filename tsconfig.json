{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    /* Lit relies on accessor-based reactive properties: class fields must be
       assigned, not defined, or the @property decorator is shadowed. */
    "useDefineForClassFields": false,
    "experimentalDecorators": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "paths": {
      "kanto": ["./src/index.ts"],
      "kanto/*": ["./src/*"]
    },

    /* Private `#internal/*` modules resolve to the sources here and to the
       emitted declarations in a consumer's install. Both spellings live in
       package.json's `imports`; this condition picks the source one. */
    "customConditions": ["kanto-source"]
  },
  /* Everything, so the editor and ESLint understand every file in the repo.
     The published build narrows this down in tsconfig.build.json. */
  "include": ["src", "demo", "scripts", "*.ts", "*.js"]
}
